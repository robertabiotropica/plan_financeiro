rules_version = '2';
// Regras de segurança do MiMimei. Copie este arquivo inteiro em
// Firebase Console → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function isMember(hid) { return signedIn() && request.auth.uid in household(hid).members; }

    // Perfil de cada login: só a própria pessoa lê e escreve.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Conta (dados em comum). Quem cria é o único membro inicial.
    match /households/{hid} {
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid;

      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Membros editam tudo; quem tem um convite válido só pode se adicionar.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinedWith'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinedWith))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWith)).data.householdId == hid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWith)).data.expiresAt > request.time
        )
      );
      allow delete: if false;

      match /transactions/{tid} {
        allow read, write: if isMember(hid);
      }
    }

    // Convites: o código é o próprio id do documento (difícil de adivinhar).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn() && isMember(resource.data.householdId);
    }
  }
}
